# Supabase (S-012)
# CLI 2.101+ : nouveau système de clés. NEXT_PUBLIC_SUPABASE_ANON_KEY reçoit la clé
# « publishable » (sb_publishable_…, publique), SUPABASE_SERVICE_ROLE_KEY la clé
# « secret » (sb_secret_…, serveur uniquement, bypass RLS). Local : `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Price feed — Firecrawl (S-008)
FIRECRAWL_API_KEY=

# LLM plateforme — proxy LiteLLM (S-034, spec n°3). SERVEUR UNIQUEMENT (jamais NEXT_PUBLIC, jamais
# dans le bundle client). Le provider/modèle réel se règle DANS LiteLLM ; l'app référence un modèle.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Optionnel : modèle/alias à appeler (défaut code : deepseek-v4-flash).
LITELLM_MODEL=
